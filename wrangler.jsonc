{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-website",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-05-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
